{
	"layer" : "bot",
	"position": "top",
	"height": 32,
	"spacing": 0,
	"margin-top": 4,
	"margin-bottom": 0,
	"margin-left": 200,
	"margin-right": 200,

	"modules-left": [
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		//"cpu",
		//"custom/gpu",
		//"memory",
		"network",
		"battery",
		"pulseaudio",
		"tray",
		"clock"
	],

	"hyprland-workspaces": {
		"format": "{name}",
		"on-scroll-up": "hyprctl dispatch workspace e+1",
		"on-scroll-down": "hyprctl dispatch workspace e-1"
	},

	"hyprland/window": {
		"format": "{}",
		"max-length": 60
	},

	"cpu": {
		"format": "CPU {usage}%"
	},

//	"custom/gpu": {
//		"exec": "nvidia-smi --query-gpu=utilization.gpu,temprature.gpu --format=csv,noheader, nounits",
//		"interval": 5,
//		"format": "GPU {}",
//		"tooltip": true,
//		"tooltip-format": "NVIDIA RTX 3050\nUsage: {}"
//	},

//	"memory": {
//		"format": "RAM {percentage}%"
//	},

	"battery": {
		"states": {
		        "warning": 30,
        		"critical": 15
		},
	        "format": "{icon} {capacity}%",
        	"format-charging": "󰂄 {capacity}%",
	        "format-plugged": "󰂄{capacity}%",
        	"format-alt": "{icon} {time}",
        	"format-full": "󱈑 {capacity}%",
        	"format-icons": [
        		"󱊡",
	        	"󱊢",
        		"󱊣"
        	]
        },

	"pulseaudio": {
		"scroll-step": 5,
		"max-volume": 150,
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon} {volume}%",
		//"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
		"format-icons": [
      		  "",
      		  "",
      		  " "
    		],
		"nospacing": 1,
		"format-muted": " ",
		"on-click": "pavucontrol",
		"tooltip": false
	},

	"network": {
		"format-wifi": "  {bandwidthDownBits}",
		"format-ethernet": "  ETH {bandwidthDownBits}",
		"format-disconnected": "󰤮  No Network",
		"interval": 5,
		"tooltip": false
	},

	"clock": {
		"format": "󰅐 {:%H:%M}",
		"tooltip": false
	},

	"tray": {
		"spacing": 10,
		"tooltip": false
	}
}
