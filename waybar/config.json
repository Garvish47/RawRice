{
	"layer" : "bot",
	"position": "top",
	"height": 32,
	"spacing": 0,
	"margin-top": 4,
	"margin-bottom": 0,
	"margin-left": 200,
	"margin-right": 200,

	"modules-left": [
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		//"cpu",
		//"custom/gpu",
		//"memory",
		"battery",
		"pulseaudio",
		"network",
		"clock"
	],

	"hyprland-workspaces": {
		"format": "{name}",
		"on-scroll-up": "hyprctl dispatch workspace e+1",
		"on-scroll-down": "hyprctl dispatch workspace e-1"
	},

	"hyprland/window": {
		"format": "{}",
		"max-length": 60
	},

	"cpu": {
		"format": "CPU {usage}%"
	},

	"custom/gpu": {
		"exec": "nvidia-smi --query-gpu=utilization.gpu,temprature.gpu --format=csv,noheader, nounits",
		"interval": 5,
		"format": "GPU {}",
		"tooltip": true,
		"tooltip-format": "NVIDIA RTX 3050\nUsage: {}"
	},

	"memory": {
		"format": "RAM {percentage}%"
	},

	"battery": {
		"bat": "BAT1",
		"format": "CHARGE {capacity}%",
		"format-charging": "CHARGING {capacity}%"
	},

	"pulseaudio": {
		"format": "VOL {volume}%",
		"format-muted": "VOL MUTED",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	},

	"network": {
		"format-wifi": "WIFI {essid}",
		"format-ethernet": "ETH {ifname}",
		"format-disconnected": "OFFLINE"
	},

	"clock": {
		"format": "{:%H:%M}"
	}
}
